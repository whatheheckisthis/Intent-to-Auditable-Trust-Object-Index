# File: containers/determinism-harness/Containerfile
# Role: Rootless Podman image for deterministic dual-run verification and digest comparison.
# Constraints enforced: pinned-digest-base-images, rootless-runtime, read-only-compatible-layout, no-ENV-instructions, multi-stage-build.
# Upstream: emit-trace-matrix
# Downstream: run-mutation-suite
FROM node:22-slim@sha256:1111111111111111111111111111111111111111111111111111111111111111 AS builder
WORKDIR /build
COPY orchestration/package.json orchestration/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit

FROM cgr.dev/chainguard/node@sha256:2222222222222222222222222222222222222222222222222222222222222222 AS runtime
WORKDIR /harness
USER 65532:65532
COPY --from=builder /build/node_modules ./node_modules
COPY orchestration/harness.js ./
COPY orchestration/harness.schema.json ./
COPY schemas/determinism-result.schema.json /schemas/determinism-result.schema.json
ENTRYPOINT ["node", "harness.js"]
