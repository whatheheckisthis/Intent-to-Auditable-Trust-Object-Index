# File: containers/sbom-generator/Containerfile
# Role: Rootless Podman container that runs Syft against pinned image digests and package manifests.
# Constraints enforced: pinned digest FROM, rootless runtime image, no ENV instructions, deterministic ENTRYPOINT.
# Upstream: build-containers
# Downstream: evaluate-policies
FROM anchore/syft@sha256:7ef283300f95237cd8f79df1ef2074a7d4f684ca8f8f4f8ed6c5d8db78e018f0 AS syft-base

FROM cgr.dev/chainguard/static@sha256:8e5865b4ea65f05eb1cb95f7f1fca2ce070782f5ce0f8345e9e6dddc6bf4f0d2 AS runtime

COPY --from=syft-base /syft /usr/bin/syft

WORKDIR /workspace

ENTRYPOINT ["/usr/bin/syft"]
