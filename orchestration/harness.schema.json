{
  "# CONSTRAINT TRADE-OFF": "JSON has no native comment syntax, so required file metadata is encoded as reserved metadata fields.",
  "__file": "orchestration/harness.schema.json",
  "__role": "Schema contract for deterministic harness execution inputs.",
  "__constraints_enforced": [
    "typed-harness-input-contract",
    "run-count-fixed-to-two",
    "no-additional-properties"
  ],
  "__upstream": "emit-trace-matrix",
  "__downstream": "run-determinism-harness",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pipeline_image_digest",
    "input_fixture_path",
    "output_scope_path",
    "run_count"
  ],
  "properties": {
    "pipeline_image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "input_fixture_path": {
      "type": "string",
      "minLength": 1
    },
    "output_scope_path": {
      "type": "string",
      "minLength": 1
    },
    "run_count": {
      "type": "integer",
      "const": 2
    }
  }
}
