{
  "# CONSTRAINT TRADE-OFF": "JSON has no native comment syntax, so required file metadata is encoded as reserved metadata fields.",
  "__file": "orchestration/runner.schema.json",
  "__role": "JSON Schema draft-2020-12 for deterministic runner input payload.",
  "__constraints_enforced": [
    "typed-schema-input",
    "fail-fast-required-fields",
    "static-stage-enumeration",
    "ENV-empty-contract"
  ],
  "__upstream": "validate-inputs",
  "__downstream": "run-execution-orchestration",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deterministic-assurance.local/schemas/runner.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stage",
    "workingDirectory"
  ],
  "properties": {
    "stage": {
      "type": "string",
      "enum": [
        "validate-inputs",
        "build-containers",
        "run-governance-policy",
        "run-cross-framework-alignment",
        "run-execution-orchestration",
        "run-validation-analytics",
        "sign-and-emit"
      ]
    },
    "workingDirectory": {
      "type": "string",
      "minLength": 1
    }
  }
}
