{
  "# CONSTRAINT TRADE-OFF": "JSON has no native comment syntax, so required file metadata is encoded as reserved metadata fields.",
  "__file": "orchestration/sbom-runner.schema.json",
  "__role": "Input contract for schema-bound Syft invocation.",
  "__constraints_enforced": [
    "typed-input-contract",
    "fail-fast-required-fields",
    "no-additional-properties"
  ],
  "__upstream": "build-containers",
  "__downstream": "generate-sbom",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["target", "output_path", "catalogers"],
  "properties": {
    "target": {
      "type": "string",
      "format": "uri"
    },
    "output_path": {
      "type": "string",
      "minLength": 1
    },
    "catalogers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
