{
  "# CONSTRAINT TRADE-OFF": "JSON has no native comment syntax, so required file metadata is encoded as reserved metadata fields.",
  "__file": "pipeline/bundle-config.json",
  "__role": "Deterministic declaration of artefacts for regulatory evidence bundle assembly.",
  "__constraints_enforced": [
    "explicit-evidence-input-list",
    "timestamp-as-parameter",
    "no-additional-properties"
  ],
  "__upstream": "run-mutation-suite",
  "__downstream": "package-evidence-bundle",
  "$schema": "../schemas/bundle-config.schema.json",
  "bundle_id": "regulatory-evidence-bundle-v1",
  "pipeline_run_ref": "assurance-pipeline-manual",
  "created_at_parameter": "INJECTED_FROM_pipeline.config.json",
  "framework_version": "ISM-2025-04 / APRA-CPS-234 / SLSA-3",
  "cosign_policy": {
    "rekor_url": "https://rekor.sigstore.dev",
    "certificate_identity_regexp": "https://github.com/.+",
    "certificate_oidc_issuer": "https://token.actions.githubusercontent.com"
  },
  "artefacts": [
    {
      "name": "attestation.json",
      "source_path": "pipeline/outputs/attestation.json",
      "producing_stage": "sign-and-attest",
      "framework_controls": ["ISM-0149", "SLSA-L3"]
    },
    {
      "name": "sbom-cyclonedx.json",
      "source_path": "pipeline/outputs/sbom-cyclonedx.json",
      "producing_stage": "generate-sbom",
      "framework_controls": ["APRA-CPS-234", "E8-ML3"]
    },
    {
      "name": "coverage-table.md",
      "source_path": "pipeline/outputs/coverage-table.md",
      "producing_stage": "emit-trace-matrix",
      "framework_controls": ["ISM-1858"]
    },
    {
      "name": "determinism-result.json",
      "source_path": "pipeline/outputs/harness/determinism-result.json",
      "producing_stage": "run-determinism-harness",
      "framework_controls": ["ISM-0407"]
    },
    {
      "name": "mutation-report.json",
      "source_path": "pipeline/outputs/mutations/mutation-report.json",
      "producing_stage": "run-mutation-suite",
      "framework_controls": ["ISM-0407"]
    },
    {
      "name": "policy-eval-output.json",
      "source_path": "pipeline/outputs/policy-eval-output.json",
      "producing_stage": "evaluate-policies",
      "framework_controls": ["ISM-1491"]
    }
  ]
}
