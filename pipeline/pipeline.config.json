{
  "# CONSTRAINT TRADE-OFF": "JSON has no native comment syntax, so required file metadata is encoded as reserved metadata fields.",
  "__file": "pipeline/pipeline.config.json",
  "__role": "Schema-bound deterministic pipeline configuration source of truth.",
  "__constraints_enforced": [
    "declared-timeout-constants",
    "declared-output-scope",
    "declared-signing-key-mount",
    "single-source-of-truth"
  ],
  "__upstream": "ROOT",
  "__downstream": "validate-inputs",
  "pipeline_run_ref": "INJECTED_FROM_GIT_SHA_OR_PIPELINE_RUN_ID",
  "pipeline": {
    "timeoutsMinutes": {
      "build-containers": 20,
      "run-governance-policy": 15,
      "run-cross-framework-alignment": 15,
      "run-execution-orchestration": 15,
      "run-validation-analytics": 15,
      "generate-sbom": 15,
      "evaluate-policies": 10,
      "sign-and-attest": 10,
      "emit-trace-matrix": 10,
      "run-determinism-harness": 10,
      "run-mutation-suite": 10,
      "package-evidence-bundle": 10,
      "generate-runbook": 10
    },
    "outputScopeVolume": "assurance-evidence-store",
    "signingKeyMountPath": "/signing-key/ed25519.key",
    "inputSchemaPath": "schemas/s-in.schema.json",
    "outputSchemaPath": "schemas/s-out.schema.json",
    "toolVersions": {
      "conftest": "0.62.0",
      "cosign": "v2.4.1",
      "ajvCli": "5.0.0"
    },
    "runtimeVersionsConfigPath": "pipeline/runtime-versions.json",
    "evidenceRetentionDays": 2557,
    "determinismHarnessDigest": "sha256:3333333333333333333333333333333333333333333333333333333333333333",
    "mutationRunnerDigest": "sha256:4444444444444444444444444444444444444444444444444444444444444444",
    "bundleCreatedAtParameter": "2026-04-25T00:00:00Z",
    "stages": [
      {
        "id": "validate-inputs",
        "description": "Validate schema contracts and pipeline configuration before execution.",
        "depends_on": [],
        "container": "localhost/assurance/validation:deterministic",
        "input_schema": "orchestration/runner.schema.json",
        "output_schema": "schemas/s-in.schema.json",
        "failure_mode": "HALT_PIPELINE",
        "framework_controls": [
          "CTRL-INPUT-01"
        ]
      },
      {
        "id": "build-containers",
        "description": "Build all deterministic rootless Podman runtime images.",
        "depends_on": [
          "validate-inputs"
        ],
        "container": "localhost/assurance/build-images:deterministic",
        "input_schema": "schemas/s-in.schema.json",
        "output_schema": "schemas/s-out.schema.json",
        "failure_mode": "HALT_PIPELINE",
        "framework_controls": [
          "CTRL-SUPPLY-01"
        ]
      },
      {
        "id": "run-governance-policy",
        "description": "Execute governance policy stage against validated inputs.",
        "depends_on": [
          "build-containers"
        ],
        "container": "localhost/assurance/governance-policy:deterministic",
        "input_schema": "schemas/s-in.schema.json",
        "output_schema": "schemas/s-out.schema.json",
        "failure_mode": "EMIT_FAILURE_RECORD_AND_HALT",
        "framework_controls": [
          "CTRL-INPUT-01"
        ]
      },
      {
        "id": "run-cross-framework-alignment",
        "description": "Normalize framework mappings for downstream control evaluation.",
        "depends_on": [
          "run-governance-policy"
        ],
        "container": "localhost/assurance/cross-framework-alignment:deterministic",
        "input_schema": "schemas/s-in.schema.json",
        "output_schema": "schemas/s-out.schema.json",
        "failure_mode": "EMIT_FAILURE_RECORD_AND_HALT",
        "framework_controls": [
          "CTRL-PROV-01"
        ]
      },
      {
        "id": "run-execution-orchestration",
        "description": "Execute deterministic orchestration DAG stage.",
        "depends_on": [
          "run-cross-framework-alignment"
        ],
        "container": "localhost/assurance/execution-orchestration:deterministic",
        "input_schema": "orchestration/runner.schema.json",
        "output_schema": "schemas/s-out.schema.json",
        "failure_mode": "HALT_PIPELINE",
        "framework_controls": [
          "CTRL-INFRA-01"
        ]
      },
      {
        "id": "run-validation-analytics",
        "description": "Run validation analytics over execution outputs.",
        "depends_on": [
          "run-execution-orchestration"
        ],
        "container": "localhost/assurance/validation-analytics:deterministic",
        "input_schema": "schemas/s-in.schema.json",
        "output_schema": "schemas/s-out.schema.json",
        "failure_mode": "EMIT_FAILURE_RECORD_AND_HALT",
        "framework_controls": [
          "CTRL-INPUT-01"
        ]
      },
      {
        "id": "generate-sbom",
        "description": "Generate CycloneDX SBOM from built artefacts.",
        "depends_on": [
          "run-validation-analytics"
        ],
        "container": "sbom-generator@sha256:5555555555555555555555555555555555555555555555555555555555555555",
        "input_schema": "orchestration/sbom-runner.schema.json",
        "output_schema": "schemas/sbom-result.schema.json",
        "failure_mode": "HALT_PIPELINE",
        "framework_controls": [
          "CTRL-SUPPLY-01"
        ]
      },
      {
        "id": "evaluate-policies",
        "description": "Evaluate runtime policy assertions with OPA/Conftest.",
        "depends_on": [
          "generate-sbom"
        ],
        "container": "localhost/assurance/policy-evaluator:deterministic",
        "input_schema": "policies/podman-runtime.schema.json",
        "output_schema": "schemas/s-out.schema.json",
        "failure_mode": "HALT_PIPELINE",
        "framework_controls": [
          "CTRL-INFRA-01"
        ]
      },
      {
        "id": "sign-and-attest",
        "description": "Keyless sign and attest pipeline outputs for provenance.",
        "depends_on": [
          "evaluate-policies"
        ],
        "container": "localhost/assurance/sign-and-attest:deterministic",
        "input_schema": "schemas/attestation.schema.json",
        "output_schema": "schemas/s-out.schema.json",
        "failure_mode": "EMIT_FAILURE_RECORD_AND_HALT",
        "framework_controls": [
          "CTRL-AUD-01",
          "CTRL-PROV-01"
        ]
      },
      {
        "id": "emit-trace-matrix",
        "description": "Emit control-to-evidence traceability matrix and coverage table.",
        "depends_on": [
          "sign-and-attest"
        ],
        "container": "localhost/assurance/trace-matrix:deterministic",
        "input_schema": "schemas/mapping-matrix.schema.json",
        "output_schema": "schemas/s-out.schema.json",
        "failure_mode": "HALT_PIPELINE",
        "framework_controls": [
          "CTRL-PROV-01"
        ]
      },
      {
        "id": "run-determinism-harness",
        "description": "Execute dual-run deterministic harness and compare output digests.",
        "depends_on": [
          "emit-trace-matrix"
        ],
        "container": "determinism-harness@sha256:3333333333333333333333333333333333333333333333333333333333333333",
        "input_schema": "orchestration/harness.schema.json",
        "output_schema": "schemas/determinism-result.schema.json",
        "failure_mode": "EMIT_FAILURE_RECORD_AND_HALT",
        "framework_controls": [
          "CTRL-INPUT-01"
        ]
      },
      {
        "id": "run-mutation-suite",
        "description": "Execute schema mutation suite and enforce zero escapes.",
        "depends_on": [
          "run-determinism-harness"
        ],
        "container": "mutation-runner@sha256:4444444444444444444444444444444444444444444444444444444444444444",
        "input_schema": "schemas/mutation-manifest.schema.json",
        "output_schema": "schemas/mutation-report.schema.json",
        "failure_mode": "EMIT_FAILURE_RECORD_AND_HALT",
        "framework_controls": [
          "CTRL-INPUT-01"
        ]
      },
      {
        "id": "package-evidence-bundle",
        "description": "Assemble and hash-bind regulatory evidence package.",
        "depends_on": [
          "run-mutation-suite"
        ],
        "container": "localhost/assurance/evidence-packager:deterministic",
        "input_schema": "schemas/bundle-config.schema.json",
        "output_schema": "schemas/bundle-manifest.schema.json",
        "failure_mode": "HALT_PIPELINE",
        "framework_controls": [
          "CTRL-AUD-01",
          "CTRL-SUPPLY-01"
        ]
      },
      {
        "id": "generate-runbook",
        "description": "Generate terminal machine-readable operator runbook from DAG config.",
        "depends_on": [
          "package-evidence-bundle"
        ],
        "container": "localhost/assurance/runbook-generator:deterministic",
        "input_schema": "pipeline/pipeline.config.json",
        "output_schema": "schemas/runbook.schema.json",
        "failure_mode": "HALT_PIPELINE",
        "framework_controls": [
          "CTRL-PROV-01"
        ]
      }
    ]
  },
  "slsa_verifier_version": "2.6.0",
  "slsa_generator_version": "v2.1.0",
  "slsa_provenance_filename": "assurance-platform.intoto.jsonl",
  "canary_build_placements_path": "canary/tracebit-build-placements.json",
  "canary_build_deployer_input_path": "pipeline/canary-build-deployer-input.json",
  "toolchain": {
    "target_architecture": "oci",
    "version": "5.0.0",
    "artefact_name": "iato-build-oci.tar"
  },
  "image_digests": {
    "build": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
    "sbom_generator": "sha256:5555555555555555555555555555555555555555555555555555555555555555",
    "determinism_harness": "sha256:3333333333333333333333333333333333333333333333333333333333333333"
  },
  "tool_digests": {
    "conftest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  }
}