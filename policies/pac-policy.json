{
  "# CONSTRAINT TRADE-OFF": "JSON does not support comments; required file header metadata and trade-off annotations are encoded as reserved keys.",
  "__file": "policies/pac-policy.json",
  "__role": "Canonical, immutable JSON policy object for deterministic policy-as-code evaluation.",
  "__constraints_enforced": [
    "schema-bound-policy-object",
    "immutable-evaluation-input",
    "declarative-condition-blocks",
    "no-runtime-inference"
  ],
  "__upstream": "ROOT",
  "__downstream": "evaluate-policies",
  "# CONSTRAINT TRADE-OFF.rule_id_pattern": "Specification rule_id regex (^RULE-[A-Z0-9]{4}$) conflicts with mandated IDs (for example RULE-NET01); schema allows 4-5 suffix characters to preserve deterministic validation for required IDs.",
  "# CONSTRAINT TRADE-OFF.targets.azure_policy": "Azure policy shape is retained as structural artefact only because live ARM evaluation requires external cloud credentials outside pipeline scope.",
  "# CONSTRAINT TRADE-OFF.targets.aws_iam": "AWS IAM/SCP shape is retained as structural artefact only because live STS-backed evaluation requires external cloud credentials outside pipeline scope.",
  "$schema": "../schemas/pac-policy.schema.json",
  "metadata": {
    "policy_id": "PAC-PODMAN-RUNTIME-001",
    "policy_version": "1.0.0",
    "description": "Deterministic Podman runtime policy object for schema-bound, engine-agnostic enforcement.",
    "ism_controls": [
      "ISM-0149",
      "ISM-1491",
      "ISM-0407"
    ],
    "framework_version": "ISM-2025-04 / E8-ML3-2025 / SOC2-2024",
    "effect_default": "Deny"
  },
  "rules": [
    {
      "rule_id": "RULE-RO01",
      "description": "Container runtime must enable a read-only root filesystem.",
      "effect": "Deny",
      "condition": {
        "field": "read_only",
        "operator": "equals",
        "value": true
      },
      "remediation": "--read-only flag required",
      "ism_controls": [
        "ISM-1491"
      ]
    },
    {
      "rule_id": "RULE-NET01",
      "description": "Container runtime must disable external network attachment.",
      "effect": "Deny",
      "condition": {
        "field": "network",
        "operator": "equals",
        "value": "none"
      },
      "remediation": "--network=none flag required",
      "ism_controls": [
        "ISM-1491"
      ]
    },
    {
      "rule_id": "RULE-ENV01",
      "description": "Container runtime must block host environment variable inheritance.",
      "effect": "Deny",
      "condition": {
        "field": "env_host",
        "operator": "equals",
        "value": false
      },
      "remediation": "--env-host=false flag required",
      "ism_controls": [
        "ISM-0407"
      ]
    },
    {
      "rule_id": "RULE-PRV01",
      "description": "Container runtime must run without privileged execution mode.",
      "effect": "Deny",
      "condition": {
        "field": "privileged",
        "operator": "equals",
        "value": false
      },
      "remediation": "rootless execution required",
      "ism_controls": [
        "ISM-1491"
      ]
    },
    {
      "rule_id": "RULE-DGS01",
      "description": "Container image reference must be pinned to an immutable SHA-256 digest.",
      "effect": "Deny",
      "condition": {
        "field": "image_digest",
        "operator": "matches_pattern",
        "value": "^sha256:[0-9a-f]{64}$"
      },
      "remediation": "pinned digest required",
      "ism_controls": [
        "ISM-1753"
      ]
    }
  ],
  "parameters": {
    "allowed_networks": {
      "type": "array",
      "default_value": [
        "none",
        "internal"
      ],
      "description": "Permitted network modes for container execution.",
      "ism_control_rationale": "ISM-1491: restrict container network access to declared scopes"
    },
    "require_digest_pin": {
      "type": "boolean",
      "default_value": true,
      "description": "Require all images to be referenced by SHA-256 digest.",
      "ism_control_rationale": "ISM-1753: supply chain integrity via immutable image reference"
    },
    "evaluation_mode": {
      "type": "string",
      "default_value": "enforce",
      "description": "Policy evaluation mode. enforce = Deny, audit = log only.",
      "ism_control_rationale": "ISM-0407: fail-fast enforcement at container boundary"
    }
  },
  "targets": {
    "opa": {
      "input_schema_ref": "../schemas/podman-runtime.schema.json",
      "policy_file_ref": "podman-runtime.rego",
      "namespace": "podman.runtime",
      "conditions": [
        {
          "rule_id": "RULE-RO01",
          "field": "read_only",
          "operator": "equals",
          "value": true
        },
        {
          "rule_id": "RULE-NET01",
          "field": "network",
          "operator": "in",
          "value": [
            "none",
            "internal"
          ]
        },
        {
          "rule_id": "RULE-ENV01",
          "field": "env_host",
          "operator": "equals",
          "value": false
        },
        {
          "rule_id": "RULE-PRV01",
          "field": "privileged",
          "operator": "equals",
          "value": false
        },
        {
          "rule_id": "RULE-DGS01",
          "field": "image_digest",
          "operator": "matches_pattern",
          "value": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "azure_policy": {
      "shape_version": "2021-06-01",
      "coverage_status": "COVERAGE_STRUCTURAL_ONLY",
      "gap_note": "Live evaluation requires Azure Resource Manager API access and a service principal. Not available in the Podman pipeline scope. Shape is verified by schema only.",
      "policyRule": {
        "if": {
          "allOf": [
            {
              "field": "type",
              "equals": "Microsoft.ContainerInstance/containerGroups"
            },
            {
              "field": "properties.osType",
              "equals": "Linux"
            }
          ]
        },
        "then": {
          "effect": "[parameters('effect')]",
          "details": {
            "type": "Microsoft.ContainerInstance/containerGroups",
            "existenceCondition": {
              "allOf": [
                {
                  "field": "properties.containers[*].securityContext.privileged",
                  "equals": false
                },
                {
                  "field": "properties.ipAddress.type",
                  "equals": "Private"
                }
              ]
            }
          }
        }
      },
      "parameters": {
        "effect": {
          "type": "String",
          "allowedValues": [
            "Deny",
            "Audit",
            "Disabled"
          ],
          "defaultValue": "Deny"
        }
      }
    },
    "aws_iam": {
      "shape_version": "2012-10-17",
      "coverage_status": "COVERAGE_STRUCTURAL_ONLY",
      "gap_note": "Live evaluation requires AWS STS credentials and account context. Not available in the Podman pipeline scope. Shape is verified by schema only.",
      "Statement": [
        {
          "Sid": "DenyPrivilegedContainerRun",
          "Effect": "Deny",
          "Action": [
            "ecs:RunTask",
            "ecs:StartTask",
            "ecs:CreateService"
          ],
          "Resource": "*",
          "Condition": {
            "Bool": {
              "ecs:container-privileged": "true"
            }
          }
        },
        {
          "Sid": "DenyUnpinnedImageReference",
          "Effect": "Deny",
          "Action": [
            "ecs:RunTask",
            "ecs:StartTask"
          ],
          "Resource": "*",
          "Condition": {
            "StringNotLike": {
              "ecs:container-image": "*@sha256:*"
            }
          }
        }
      ]
    }
  },
  "framework_mappings": [
    {
      "rule_id": "RULE-RO01",
      "framework_refs": [
        "ISM-1491",
        "E8-ML3-APP-2",
        "SOC2-CC6.6"
      ],
      "control_id": "CTRL-INFRA-01"
    },
    {
      "rule_id": "RULE-NET01",
      "framework_refs": [
        "ISM-1491",
        "E8-ML3-APP-2",
        "SOC2-CC6.6"
      ],
      "control_id": "CTRL-INFRA-01"
    },
    {
      "rule_id": "RULE-ENV01",
      "framework_refs": [
        "ISM-0407",
        "E8-ML3-APP-3",
        "SOC2-CC6.1"
      ],
      "control_id": "CTRL-INPUT-01"
    },
    {
      "rule_id": "RULE-PRV01",
      "framework_refs": [
        "ISM-1491",
        "E8-ML3-APP-2",
        "SOC2-CC6.6"
      ],
      "control_id": "CTRL-INFRA-01"
    },
    {
      "rule_id": "RULE-DGS01",
      "framework_refs": [
        "ISM-1753",
        "E8-ML3-PATCH-1",
        "SOC2-CC8.1"
      ],
      "control_id": "CTRL-SUPPLY-01"
    }
  ]
}
