{
  "# CONSTRAINT TRADE-OFF": "JSON has no native comment syntax, so required file metadata is encoded as reserved metadata fields.",
  "__file": "policies/podman-runtime.schema.json",
  "__role": "Conftest input schema for mandatory Podman runtime security flags.",
  "__constraints_enforced": [
    "typed-policy-input",
    "required-runtime-flags",
    "no-additional-properties"
  ],
  "__upstream": "generate-sbom",
  "__downstream": "evaluate-policies",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "container_name",
    "read_only",
    "network",
    "env_host",
    "privileged",
    "image_digest"
  ],
  "properties": {
    "container_name": { "type": "string", "minLength": 1 },
    "read_only": { "type": "boolean" },
    "network": {
      "type": "string",
      "enum": ["none", "internal"]
    },
    "env_host": { "type": "boolean" },
    "privileged": { "type": "boolean" },
    "image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
