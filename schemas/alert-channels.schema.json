{
  "# CONSTRAINT TRADE-OFF": "Acknowledge-first escalation timing is represented as integer policy fields consumed by downstream handlers; enforcement occurs outside this static schema.",
  "__file": "schemas/alert-channels.schema.json",
  "__role": "Schema for alert channel endpoint references, acknowledgement discipline, and severity routing.",
  "__constraints_enforced": [
    "acknowledgement-required-by-default",
    "severity-channel-routing",
    "no-additional-properties"
  ],
  "__upstream": "register-webhooks",
  "__downstream": "security_operations",
  "__ism_controls": ["ISM-0109", "ISM-1554", "ISM-1858"],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlertChannels",
  "type": "object",
  "required": ["$schema", "channels", "severity_routing", "fatigue_guard"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "const": "../schemas/alert-channels.schema.json" },
    "channels": {
      "type": "object",
      "required": ["slack_webhook", "grafana_irm", "siem", "ticketing"],
      "additionalProperties": false,
      "properties": {
        "slack_webhook": { "$ref": "#/$defs/channel" },
        "grafana_irm": { "$ref": "#/$defs/channel" },
        "siem": { "$ref": "#/$defs/channel" },
        "ticketing": { "$ref": "#/$defs/channel" }
      }
    },
    "severity_routing": {
      "type": "object",
      "required": ["CRITICAL", "HIGH", "MEDIUM", "LOW"],
      "additionalProperties": false,
      "properties": {
        "CRITICAL": { "$ref": "#/$defs/channelList" },
        "HIGH": { "$ref": "#/$defs/channelList" },
        "MEDIUM": { "$ref": "#/$defs/channelList" },
        "LOW": { "$ref": "#/$defs/channelList" }
      }
    },
    "fatigue_guard": {
      "type": "object",
      "required": ["max_alerts_per_token_per_hour", "dedup_window_seconds", "acknowledge_to_ungroup_note"],
      "additionalProperties": false,
      "properties": {
        "max_alerts_per_token_per_hour": { "type": "integer", "minimum": 1 },
        "dedup_window_seconds": { "type": "integer", "minimum": 1 },
        "acknowledge_to_ungroup_note": { "type": "string", "minLength": 12 }
      }
    }
  },
  "$defs": {
    "channelList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["grafana_irm", "slack_webhook", "siem", "ticketing"] },
      "uniqueItems": true
    },
    "channel": {
      "type": "object",
      "required": [
        "type",
        "endpoint_path",
        "severity_threshold",
        "acknowledgement_required",
        "acknowledgement_window_seconds",
        "ism_controls"
      ],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["slack", "grafana_irm", "splunk_hec", "webhook"] },
        "endpoint_path": { "type": "string", "pattern": "^/run/secrets/[A-Za-z0-9._-]+$" },
        "severity_threshold": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
        "acknowledgement_required": { "type": "boolean", "default": true },
        "acknowledgement_window_seconds": { "type": "integer", "minimum": 1 },
        "paging_mode": { "type": "string" },
        "structured_format": { "type": "string" },
        "ism_controls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^ISM-[0-9]{4}$" }
        }
      }
    }
  }
}
