{
  "# CONSTRAINT TRADE-OFF": "JSON has no native comment syntax, so required file metadata is encoded as reserved metadata fields.",
  "__file": "schemas/asset-surface-map.schema.json",
  "__role": "Schema for flock-organised asset surface mapping and token type governance.",
  "__constraints_enforced": [
    "strict-risk-tier-enumeration",
    "token-type-governance-by-flock",
    "no-additional-properties"
  ],
  "__upstream": "ROOT",
  "__downstream": "embed-canaries",
  "__ism_controls": ["ISM-0109", "ISM-0140", "ISM-0585", "ISM-1554"],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssetSurfaceMap",
  "type": "object",
  "required": ["$schema", "surface_version", "flocks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "const": "../schemas/asset-surface-map.schema.json" },
    "surface_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "flocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "flock_id",
          "description",
          "risk_tier",
          "permitted_token_types",
          "alert_channel_primary",
          "alert_channel_secondary",
          "alert_severity"
        ],
        "additionalProperties": false,
        "properties": {
          "flock_id": { "type": "string", "pattern": "^FLOCK-[A-Z0-9-]{3,32}$" },
          "description": { "type": "string", "minLength": 8 },
          "risk_tier": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
          "permitted_token_types": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "alert_channel_primary": { "type": "string", "minLength": 2 },
          "alert_channel_secondary": {
            "type": "array",
            "items": { "type": "string", "minLength": 2 },
            "uniqueItems": true
          },
          "alert_severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
          "fatigue_note": { "type": "string" },
          "deployment_note": { "type": "string" }
        }
      }
    }
  }
}
