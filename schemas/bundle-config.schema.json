{
  "# CONSTRAINT TRADE-OFF": "JSON has no native comment syntax, so required file metadata is encoded as reserved metadata fields.",
  "__file": "schemas/bundle-config.schema.json",
  "__role": "Schema for regulatory evidence bundle packaging configuration.",
  "__constraints_enforced": [
    "typed-bundle-config",
    "explicit-artifact-declarations",
    "no-additional-properties"
  ],
  "__upstream": "run-mutation-suite",
  "__downstream": "package-evidence-bundle",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_id",
    "pipeline_run_ref",
    "created_at_parameter",
    "framework_version",
    "cosign_policy",
    "artefacts"
  ],
  "properties": {
    "bundle_id": { "type": "string", "minLength": 1 },
    "pipeline_run_ref": { "type": "string", "minLength": 1 },
    "created_at_parameter": { "type": "string", "minLength": 1 },
    "framework_version": { "type": "string", "minLength": 1 },
    "cosign_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rekor_url",
        "certificate_identity_regexp",
        "certificate_oidc_issuer"
      ],
      "properties": {
        "rekor_url": { "type": "string", "minLength": 1 },
        "certificate_identity_regexp": { "type": "string", "minLength": 1 },
        "certificate_oidc_issuer": { "type": "string", "minLength": 1 }
      }
    },
    "artefacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source_path", "producing_stage", "framework_controls"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "source_path": { "type": "string", "minLength": 1 },
          "producing_stage": { "type": "string", "minLength": 1 },
          "framework_controls": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          }
        }
      }
    }
  }
}
