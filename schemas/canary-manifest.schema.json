{
  "# CONSTRAINT TRADE-OFF": "JSON has no native comment syntax, so required file metadata is encoded as reserved metadata fields.",
  "__file": "schemas/canary-manifest.schema.json",
  "__role": "Schema-bound manifest for runtime-injected Canary Token placements.",
  "__constraints_enforced": [
    "ENV-empty-token-url-contract",
    "strict-placement-target-enumeration",
    "no-additional-properties"
  ],
  "__upstream": "register-webhooks",
  "__downstream": "embed-canaries",
  "__ism_controls": ["ISM-0140", "ISM-0585", "ISM-1858"],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanaryManifest",
  "description": "Schema-bound manifest of Canary Token placements. Injected at runtime via volume mount. Token URLs are never present in source control.",
  "type": "object",
  "required": ["manifest_version", "tokens"],
  "additionalProperties": false,
  "properties": {
    "manifest_version": { "type": "string", "const": "1.0" },
    "tokens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "token_id",
          "token_url",
          "placement_target",
          "placement_strategy",
          "ism_controls"
        ],
        "additionalProperties": false,
        "properties": {
          "token_id": {
            "type": "string",
            "pattern": "^CANARY-[A-Z0-9]{6}$",
            "description": "Unique identifier. Referenced in alert payloads."
          },
          "token_url": {
            "type": "string",
            "format": "uri",
            "description": "Live token URL from Canary Token provider (or self-hosted). Never hardcoded in source."
          },
          "placement_target": {
            "type": "string",
            "enum": [
              "pipeline/outputs/evidence-bundle/bundle-manifest.json",
              "pipeline/outputs/evidence-bundle/verify-bundle.sh",
              "pipeline/outputs/sbom-cyclonedx.json",
              "README.md",
              "containers/governance-policy/Containerfile"
            ]
          },
          "placement_strategy": {
            "type": "string",
            "enum": [
              "embed_as_comment",
              "embed_as_metadata_field",
              "embed_as_url_reference",
              "embed_as_invisible_link"
            ],
            "description": "How the token is embedded. Must not alter the functional content of the target file."
          },
          "ism_controls": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
