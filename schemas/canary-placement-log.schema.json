{
  "# CONSTRAINT TRADE-OFF": "JSON has no native comment syntax, so required file metadata is encoded as reserved metadata fields.",
  "__file": "schemas/canary-placement-log.schema.json",
  "__role": "Schema for append-only Canary Token placement evidence records.",
  "__constraints_enforced": [
    "sha256-before-after-traceability",
    "pipeline-run-ref-temporal-decoupling",
    "no-additional-properties"
  ],
  "__upstream": "embed-canaries",
  "__downstream": "generate-runbook",
  "__ism_controls": ["ISM-0109", "ISM-0140", "ISM-0585", "ISM-1858"],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanaryPlacementLog",
  "type": "object",
  "required": ["manifest_version", "pipeline_run_ref", "placements"],
  "additionalProperties": false,
  "properties": {
    "manifest_version": { "type": "string" },
    "pipeline_run_ref": { "type": "string" },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "token_id",
          "placement_target",
          "placement_strategy",
          "sha256_digest_before",
          "sha256_digest_after",
          "ism_controls"
        ],
        "additionalProperties": false,
        "properties": {
          "token_id": { "type": "string" },
          "placement_target": { "type": "string" },
          "placement_strategy": { "type": "string" },
          "sha256_digest_before": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "sha256_digest_after": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "ism_controls": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
