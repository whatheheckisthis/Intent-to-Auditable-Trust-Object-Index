{
  "# CONSTRAINT TRADE-OFF": "JSON has no native comment syntax, so required file metadata is encoded as reserved metadata fields.",
  "__file": "schemas/failure-record.schema.json",
  "__role": "Schema for machine-readable failure records emitted by all pipeline stages.",
  "__constraints_enforced": [
    "typed-failure-categories",
    "ism-control-linkage",
    "no-additional-properties"
  ],
  "__upstream": "pipeline/emit-failure.js",
  "__downstream": "package-evidence-bundle",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FailureRecord",
  "type": "object",
  "required": [
    "failure_id",
    "failure_type",
    "pipeline_stage",
    "pipeline_run_ref",
    "severity",
    "ism_controls",
    "detail",
    "remediation"
  ],
  "additionalProperties": false,
  "properties": {
    "failure_id": {
      "type": "string",
      "pattern": "^FAIL-[A-Z0-9]{8}$"
    },
    "failure_type": {
      "type": "string",
      "enum": [
        "RUNNER_VERSION_MISMATCH",
        "ENV_CONTAMINATION",
        "ARTEFACT_INTEGRITY_FAILURE",
        "SCHEMA_VALIDATION_FAILURE",
        "DETERMINISM_FAILURE",
        "MUTATION_ESCAPE",
        "POLICY_VIOLATION",
        "CANARY_DEPLOYMENT_INCOMPLETE",
        "SLSA_VERIFICATION_FAILURE",
        "RUNTIME_INCONSISTENT",
        "PIPELINE_STAGE_FAILURE"
      ]
    },
    "pipeline_stage": { "type": "string" },
    "pipeline_run_ref": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
    },
    "ism_controls": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "detail": {
      "type": "object",
      "required": ["message", "affected_component"],
      "additionalProperties": true,
      "properties": {
        "message": { "type": "string" },
        "affected_component": { "type": "string" },
        "expected_value": { "type": ["string", "null"] },
        "actual_value": { "type": ["string", "null"] },
        "artefact_path": { "type": "string" }
      }
    },
    "remediation": { "type": "string" }
  }
}
