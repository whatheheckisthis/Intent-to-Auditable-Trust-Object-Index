{
  "# CONSTRAINT TRADE-OFF": "JSON has no native comment syntax, so required file metadata is encoded as reserved metadata fields.",
  "__file": "schemas/ingress-manifest.schema.json",
  "__role": "Schema for producer-side digest manifest used for ingress integrity checks.",
  "__constraints_enforced": [
    "sha256-digest-format-enforcement",
    "producer-attribution",
    "no-additional-properties"
  ],
  "__upstream": "pipeline/record-artefact-digests.js",
  "__downstream": "pipeline/verify-artefact-ingress.js",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "producing_pipeline_run_ref", "artefacts"],
  "properties": {
    "job_id": { "type": "string", "minLength": 1 },
    "producing_pipeline_run_ref": { "type": "string", "minLength": 1 },
    "artefacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256_digest", "producing_job"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "producing_job": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
