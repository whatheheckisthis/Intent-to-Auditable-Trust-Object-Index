{
  "# CONSTRAINT TRADE-OFF": "JSON has no native comment syntax, so required file metadata is encoded as reserved metadata fields.",
  "__file": "schemas/mapping-matrix.schema.json",
  "__role": "Schema for deterministic control-evidence mapping matrix.",
  "__constraints_enforced": [
    "typed-mapping-contract",
    "required-control-metadata",
    "no-additional-properties"
  ],
  "__upstream": "sign-and-attest",
  "__downstream": "emit-trace-matrix",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_at_parameter", "framework_version", "mappings"],
  "properties": {
    "generated_at_parameter": {
      "type": "string",
      "minLength": 1
    },
    "framework_version": {
      "type": "string",
      "minLength": 1
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "control_description",
          "framework_refs",
          "evidence_artefact",
          "pipeline_stage",
          "attestation_type",
          "coverage_status"
        ],
        "properties": {
          "control_id": { "type": "string", "minLength": 1 },
          "control_description": { "type": "string", "minLength": 1 },
          "framework_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence_artefact": { "type": "string", "minLength": 1 },
          "pipeline_stage": { "type": "string", "minLength": 1 },
          "attestation_type": { "type": "string", "minLength": 1 },
          "coverage_status": {
            "type": "string",
            "enum": ["COVERED", "PARTIAL", "GAP"]
          }
        }
      }
    }
  }
}
