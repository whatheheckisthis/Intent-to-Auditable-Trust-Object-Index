{
  "# CONSTRAINT TRADE-OFF": "JSON has no native comment syntax, so required file metadata is encoded as reserved metadata fields.",
  "__file": "schemas/mutation-manifest.schema.json",
  "__role": "Schema contract for deterministic mutation suite inputs.",
  "__constraints_enforced": [
    "typed-mutation-rules",
    "single-constraint-violation-model",
    "no-additional-properties"
  ],
  "__upstream": "run-determinism-harness",
  "__downstream": "run-mutation-suite",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["mutations"],
  "properties": {
    "mutations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mutation_id",
          "target_schema",
          "description",
          "mutation_type",
          "fixture_path",
          "expected_error_keyword"
        ],
        "properties": {
          "mutation_id": { "type": "string", "pattern": "^MUT-[0-9]{3}$" },
          "target_schema": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "mutation_type": {
            "type": "string",
            "enum": [
              "missing_required_field",
              "wrong_type",
              "additional_property",
              "enum_violation",
              "pattern_violation",
              "const_violation"
            ]
          },
          "fixture_path": { "type": "string", "minLength": 1 },
          "expected_error_keyword": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
