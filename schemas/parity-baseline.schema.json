{
  "# CONSTRAINT TRADE-OFF": "JSON has no native comment syntax, so required file metadata is encoded as reserved metadata fields.",
  "__file": "schemas/parity-baseline.schema.json",
  "__role": "Schema for canonical local/CI output digest baseline.",
  "__constraints_enforced": [
    "sha256-digest-format-enforcement",
    "runtime-anchor-capture",
    "no-additional-properties"
  ],
  "__upstream": "pipeline/capture-parity-baseline.js",
  "__downstream": "pipeline/verify-parity.js",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["captured_from_run_ref", "node_version", "podman_version", "artefacts"],
  "properties": {
    "captured_from_run_ref": { "type": "string" },
    "node_version": { "type": "string" },
    "podman_version": { "type": "string" },
    "artefacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256_digest"],
        "properties": {
          "path": { "type": "string" },
          "sha256_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    }
  }
}
