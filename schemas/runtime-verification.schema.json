{
  "# CONSTRAINT TRADE-OFF": "JSON has no native comment syntax, so required file metadata is encoded as reserved metadata fields.",
  "__file": "schemas/runtime-verification.schema.json",
  "__role": "Schema for runtime gate verification output records.",
  "__constraints_enforced": [
    "typed-runtime-status",
    "strict-tool-check-status-enum",
    "no-additional-properties"
  ],
  "__upstream": "pipeline/verify-runtime.js",
  "__downstream": "runtime-gate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "overall_status",
    "tool_checks",
    "env_contaminations",
    "env_unexpected",
    "config_path"
  ],
  "properties": {
    "overall_status": {
      "type": "string",
      "enum": ["RUNTIME_CONSISTENT", "RUNTIME_INCONSISTENT"]
    },
    "tool_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "status", "declared", "actual"],
        "properties": {
          "tool": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["PASS", "VERSION_MISMATCH", "NOT_FOUND", "PARSE_FAILURE"]
          },
          "declared": { "type": "string" },
          "actual": { "type": ["string", "null"] }
        }
      }
    },
    "env_contaminations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "env_unexpected": {
      "type": "array",
      "items": { "type": "string" }
    },
    "config_path": { "type": "string" }
  }
}
