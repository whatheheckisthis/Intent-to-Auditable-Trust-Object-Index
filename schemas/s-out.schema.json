{
  "# CONSTRAINT TRADE-OFF": "JSON has no native comment syntax, so required file metadata is encoded as reserved metadata fields.",
  "__file": "schemas/s-out.schema.json",
  "__role": "Draft-2020-12 schema for deterministic output state S_out evidence record.",
  "__constraints_enforced": [
    "typed-output-contract",
    "immutable-stage-evidence-shape",
    "fail-fast-required-fields"
  ],
  "__upstream": "run-validation-analytics",
  "__downstream": "sign-and-emit",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deterministic-assurance.local/schemas/s-out.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pipelineVersion",
    "stageResults",
    "signature"
  ],
  "properties": {
    "pipelineVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "stageResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "status",
          "artifactPath"
        ],
        "properties": {
          "stage": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "failure"
            ]
          },
          "artifactPath": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyPath",
        "signedArtifactPath"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "Ed25519"
        },
        "keyPath": {
          "type": "string",
          "minLength": 1
        },
        "signedArtifactPath": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
