{
  "# File": "schemas/slsa-provenance-decoded.schema.json",
  "# Role": "Schema for decoded in-toto Statement v1 SLSA predicate payload.",
  "# Constraints enforced": "statement-type const, slsa predicateType const, builder/invocation required",
  "# Upstream": "slsa-provenance",
  "# Downstream": "verify-provenance-and-tokens",
  "# ISM controls": "ISM-0149, ISM-1753, ISM-1858",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": { "type": "string", "const": "https://in-toto.io/Statement/v1" },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "digest"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "digest": { "type": "object", "minProperties": 1 }
        }
      }
    },
    "predicateType": { "type": "string", "const": "https://slsa.dev/provenance/v1" },
    "predicate": {
      "type": "object",
      "required": ["buildDefinition", "runDetails"],
      "properties": {
        "buildDefinition": {
          "type": "object",
          "required": ["buildType", "externalParameters"],
          "properties": {
            "buildType": { "type": "string", "minLength": 1 },
            "externalParameters": { "type": "object" }
          }
        },
        "runDetails": {
          "type": "object",
          "required": ["builder", "metadata"],
          "properties": {
            "builder": {
              "type": "object",
              "required": ["id"],
              "properties": { "id": { "type": "string", "format": "uri" } }
            },
            "metadata": {
              "type": "object",
              "required": ["invocationId"],
              "properties": { "invocationId": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    }
  }
}
