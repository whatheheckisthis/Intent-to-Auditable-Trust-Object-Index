{
  "# File": "schemas/tracebit-build-placements.schema.json",
  "# Role": "Schema for build artefact Canary Token placement manifest.",
  "# Constraints enforced": "token-name guard, public-visibility token restriction, required typed fields, no additional properties",
  "# Upstream": "ROOT",
  "# Downstream": "embed-canaries",
  "# ISM controls": "ISM-0109, ISM-0140, ISM-0585, ISM-1554",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "description", "placements"],
  "properties": {
    "manifest_version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "placements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token_id",
          "token_name",
          "token_type",
          "artefact_path",
          "embed_in_artefact",
          "placement_visibility",
          "reminder",
          "rotation_after_runs",
          "ism_controls",
          "alert_on_trigger"
        ],
        "properties": {
          "token_id": { "type": "string", "pattern": "^TRACE-[A-Z0-9-]{5,20}$" },
          "token_name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{3,63}$",
            "not": { "pattern": "(?i)(canary|test|dummy|fake|honeypot)" }
          },
          "token_type": {
            "type": "string",
            "enum": [
              "aws_api_key", "url", "dns", "pdf", "google_doc", "slack_token",
              "windows_registry", "cmd", "azure_id", "github_pat", "cloned_website", "mysql_credentials"
            ]
          },
          "artefact_path": { "type": "string", "minLength": 1 },
          "embed_in_artefact": { "type": "boolean" },
          "placement_visibility": { "type": "string", "enum": ["public", "private", "internal"] },
          "reminder": { "type": "string", "minLength": 1 },
          "rotation_after_runs": { "type": "integer", "minimum": 1 },
          "ism_controls": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^ISM-[0-9]{4}$" },
            "uniqueItems": true
          },
          "alert_on_trigger": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": { "properties": { "placement_visibility": { "const": "public" } } },
            "then": { "properties": { "token_type": { "enum": ["url", "dns"] } } }
          }
        ]
      }
    }
  }
}
