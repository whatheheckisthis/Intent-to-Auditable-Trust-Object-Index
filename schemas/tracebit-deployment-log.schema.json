{
  "# CONSTRAINT TRADE-OFF": "Deployment and rotation logs are append-only JSON files; archival state is represented by status transitions instead of in-place deletion.",
  "__file": "schemas/tracebit-deployment-log.schema.json",
  "__role": "Schema for deterministic TraceBit deployment output log used as evidence artefact.",
  "__constraints_enforced": [
    "sha256-reminder-integrity",
    "append-only-status-records",
    "no-additional-properties"
  ],
  "__upstream": "embed-canaries",
  "__downstream": "register-webhooks",
  "__ism_controls": ["ISM-0109", "ISM-0140", "ISM-0585", "ISM-1858"],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TracebitDeploymentLog",
  "type": "object",
  "required": ["pipeline_run_ref", "total_placements", "deployed", "failed", "results"],
  "additionalProperties": false,
  "properties": {
    "pipeline_run_ref": { "type": "string", "minLength": 1 },
    "total_placements": { "type": "integer", "minimum": 0 },
    "deployed": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "token_id", "token_name", "token_type", "flock_id", "placement_target",
          "thinkst_token_ref", "reminder_sha256", "rotation_after_runs", "ism_controls", "status"
        ],
        "additionalProperties": false,
        "properties": {
          "token_id": { "type": "string", "pattern": "^TRACE-[A-Z0-9]{5,8}$" },
          "token_name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{3,31}$" },
          "token_type": { "type": "string" },
          "flock_id": { "type": "string", "pattern": "^FLOCK-[A-Z0-9-]{3,32}$" },
          "placement_target": { "type": "string", "minLength": 3 },
          "thinkst_token_ref": { "type": "string", "minLength": 3 },
          "reminder_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "rotation_after_runs": { "type": "integer", "minimum": 1 },
          "ism_controls": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^ISM-[0-9]{4}$" }
          },
          "status": { "type": "string", "enum": ["DEPLOYED", "ROTATED", "ARCHIVED"] }
        }
      }
    }
  }
}
