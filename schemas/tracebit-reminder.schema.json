{
  "# CONSTRAINT TRADE-OFF": "JSON has no native comment syntax, so required file metadata is encoded as reserved metadata fields.",
  "__file": "schemas/tracebit-reminder.schema.json",
  "__role": "Schema for structured Thinkst reminder payloads serialized into manifest reminder strings.",
  "__constraints_enforced": [
    "structured-forensic-reminder-json",
    "explicit-environment-enumeration",
    "no-additional-properties"
  ],
  "__upstream": "embed-canaries",
  "__downstream": "register-webhooks",
  "__ism_controls": ["ISM-0140", "ISM-0585", "ISM-1554"],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TracebitReminder",
  "type": "object",
  "required": ["owner", "environment", "location", "flock_id", "ism_controls", "rotation_note"],
  "additionalProperties": false,
  "properties": {
    "owner": { "type": "string", "minLength": 2 },
    "environment": { "type": "string", "enum": ["production", "staging", "development", "shared"] },
    "location": { "type": "string", "minLength": 5 },
    "flock_id": { "type": "string", "pattern": "^FLOCK-[A-Z0-9-]{3,32}$" },
    "ism_controls": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^ISM-[0-9]{4}$" }
    },
    "rotation_note": { "type": "string", "minLength": 8 }
  }
}
