{
  "# CONSTRAINT TRADE-OFF": "Secrets are schema-validated from mounted files and are intentionally excluded from source and environment variables.",
  "__file": "schemas/tracebit-secrets-manifest.schema.json",
  "__role": "Schema for runtime-injected Thinkst secrets, flock identifiers, token URLs, and deterministic rotation pools.",
  "__constraints_enforced": [
    "env-empty-secret-ingestion",
    "deterministic-rotation-pool-shape",
    "no-additional-properties"
  ],
  "__upstream": "secret-mount",
  "__downstream": "embed-canaries",
  "__ism_controls": ["ISM-0109", "ISM-0140", "ISM-0585", "ISM-1858"],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TracebitSecretsManifest",
  "type": "object",
  "required": ["manifest_version", "thinkst_api_key", "flock_ids", "token_urls", "rotation_pool"],
  "additionalProperties": false,
  "properties": {
    "manifest_version": { "type": "string", "const": "1.0.0" },
    "thinkst_api_key": { "type": "string", "minLength": 10 },
    "flock_ids": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^FLOCK-[A-Z0-9-]{3,32}$" },
      "additionalProperties": { "type": "string", "minLength": 2 }
    },
    "token_urls": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^TRACE-[A-Z0-9]{5,8}$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "rotation_pool": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z_]+$" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{3,31}$",
          "not": { "pattern": "(?i)(canary|test|dummy|fake|honeypot)" }
        }
      }
    }
  }
}
