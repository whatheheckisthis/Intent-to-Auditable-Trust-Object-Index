{
  "# CONSTRAINT TRADE-OFF": "JSON has no native comment syntax, so required file metadata is encoded as reserved metadata fields.",
  "__file": "schemas/webhook-alert.schema.json",
  "__role": "Unified structured alert schema for pipeline and canary tripwire events.",
  "__constraints_enforced": [
    "typed-alert-classification",
    "pipeline-run-ref-not-clock-derived",
    "no-additional-properties"
  ],
  "__upstream": "register-webhooks",
  "__downstream": "security_operations",
  "__ism_controls": [
    "ISM-0109",
    "ISM-0140",
    "ISM-1554",
    "ISM-1858"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebhookAlert",
  "description": "Structured alert payload for all pipeline and canary tripwire events.",
  "type": "object",
  "required": [
    "alert_id",
    "alert_type",
    "pipeline_run_ref",
    "severity",
    "ism_controls",
    "detail",
    "acknowledgement_required",
    "acknowledgement_window_seconds"
  ],
  "additionalProperties": false,
  "properties": {
    "alert_id": {
      "type": "string",
      "pattern": "^ALERT-[A-Z0-9]{8}$"
    },
    "alert_type": {
      "type": "string",
      "enum": [
        "CANARY_TRIGGERED",
        "DETERMINISM_FAILURE",
        "MUTATION_ESCAPE",
        "PIPELINE_STAGE_FAILURE",
        "POLICY_VIOLATION",
        "SBOM_ACCESS_ANOMALY"
      ]
    },
    "pipeline_run_ref": {
      "type": "string",
      "description": "Git commit SHA or pipeline run ID. Never a clock-derived value."
    },
    "severity": {
      "type": "string",
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "ism_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "detail": {
      "type": "object",
      "required": [
        "source_stage",
        "message"
      ],
      "additionalProperties": true,
      "properties": {
        "source_stage": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "token_id": {
          "type": "string"
        },
        "artefact_path": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "acknowledgement_required": {
      "type": "boolean",
      "default": true
    },
    "acknowledgement_window_seconds": {
      "type": "integer",
      "minimum": 1
    }
  }
}
