{
  "# CONSTRAINT TRADE-OFF": "JSON has no native comment syntax, so required file metadata is encoded as reserved metadata fields.",
  "__file": "schemas/webhook-registration.schema.json",
  "__role": "Schema for non-blocking webhook reachability registration evidence.",
  "__constraints_enforced": [
    "append-only-registration-status",
    "pipeline-run-ref-temporal-decoupling",
    "no-additional-properties"
  ],
  "__upstream": "register-webhooks",
  "__downstream": "embed-canaries",
  "__ism_controls": ["ISM-0109", "ISM-1554", "ISM-1858"],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebhookRegistration",
  "type": "object",
  "required": ["pipeline_run_ref", "registrations"],
  "additionalProperties": false,
  "properties": {
    "pipeline_run_ref": { "type": "string" },
    "registrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["endpoint_name", "status", "ism_controls"],
        "additionalProperties": false,
        "properties": {
          "endpoint_name": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["REACHABLE", "UNREACHABLE", "TIMEOUT"]
          },
          "ism_controls": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
